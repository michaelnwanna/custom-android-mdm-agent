{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fleet:command-event:v1",
  "title": "Fleet command state event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "commandId", "deviceId", "correlationId", "recordedAt", "state"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "eventId": {"type": "string", "format": "uuid"},
    "commandId": {"type": "string", "format": "uuid"},
    "deviceId": {"type": "string", "format": "uuid"},
    "correlationId": {"type": "string", "format": "uuid"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["received", "running", "succeeded", "failed", "expired"]},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "failed"}}},
      "then": {"required": ["error"]},
      "else": {"not": {"required": ["error"]}}
    }
  ]
}