{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fleet:enrollment-response:v1",
  "title": "Fleet enrollment response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceId", "certificateDer", "intermediateCertificatesDer", "issuedAt", "expiresAt"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "deviceId": {"type": "string", "format": "uuid"},
    "certificateDer": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "intermediateCertificatesDer": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 64,
        "maxLength": 16384,
        "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
      }
    },
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}