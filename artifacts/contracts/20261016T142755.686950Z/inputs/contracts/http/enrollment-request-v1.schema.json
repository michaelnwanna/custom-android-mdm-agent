{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fleet:enrollment-request:v1",
  "title": "Fleet enrollment request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pendingEnrollmentId", "csrDer"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "pendingEnrollmentId": {"type": "string", "format": "uuid"},
    "csrDer": {
      "type": "string",
      "minLength": 64,
      "maxLength": 16384,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "description": "Standard base64 DER PKCS#10 CSR, without PEM headers or whitespace. Shape validation does not verify DER, CSR signature, key strength or identity."
    }
  }
}